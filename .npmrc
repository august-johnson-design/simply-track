# npm has a known bug where any dependency containing a binding.gyp file
# (even one with no install script and prebuilt binaries, like better-sqlite3
# v13+) gets an implicit "node-gyp rebuild" forced on it during install:
# https://github.com/npm/cli/issues/5234
# That rebuild isn't needed (better-sqlite3 ships working prebuilt binaries)
# and fails in some environments, so lifecycle scripts are disabled here.
# This also skips Electron's own postinstall (which downloads its binary) —
# that's handled instead by "node node_modules/electron/install.js" prefixed
# onto the dev/build/preview scripts, so `npm install` alone is still enough.
ignore-scripts=true
