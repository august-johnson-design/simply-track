{
  "name": "simply-track",
  "version": "0.1.0",
  "description": "Offline-first desktop client/data tracking app for small, locally owned businesses.",
  "main": "./out/main/index.js",
  "author": "August Johnson",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node node_modules/electron/install.js && electron-vite dev",
    "build": "node node_modules/electron/install.js && electron-vite build",
    "preview": "node node_modules/electron/install.js && electron-vite preview",
    "start": "node node_modules/electron/install.js && electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.augustjohnson.simplytrack",
    "productName": "simply-track",
    "npmRebuild": false,
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
